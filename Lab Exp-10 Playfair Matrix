
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char key[5][5] = {
        {'M','F','H','I','K'},
        {'U','N','O','P','Q'},
        {'Z','V','W','X','Y'},
        {'E','L','A','R','G'},
        {'D','S','T','B','C'}
    };
    char s[] = "MUSTSEEYOUOVERCADOGANWESTCOMINGATONCE";
    char out[100];
    int i, j, a, b, r1, c1, r2, c2, n = 0;

    for (i = 0; s[i]; i++) {
        if (s[i] == 'J') s[i] = 'I';
    }

    for (i = 0; s[i]; i++) {
        out[n++] = s[i];
        if (s[i] == s[i+1] && s[i+1])
            out[n++] = 'X';
    }
    out[n] = '\0';

    if (n % 2) {
        out[n++] = 'X';
        out[n] = '\0';
    }

    for (i = 0; i < n; i += 2) {
        r1=c1=r2=c2=-1;
        for (a=0; a<5; a++)
            for (b=0; b<5; b++) {
                if (key[a][b] == out[i]) r1=a,c1=b;
                if (key[a][b] == out[i+1]) r2=a,c2=b;
            }

        if (r1 == r2) {
            out[i] = key[r1][(c1+1)%5];
            out[i+1] = key[r2][(c2+1)%5];
        } else if (c1 == c2) {
            out[i] = key[(r1+1)%5][c1];
            out[i+1] = key[(r2+1)%5][c2];
        } else {
            out[i] = key[r1][c2];
            out[i+1] = key[r2][c1];
        }
    }

    printf("Encrypted message: %s\n", out);
    return 0;
}
