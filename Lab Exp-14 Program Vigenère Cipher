
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char p[] = "send more money";
    int key[] = {9,0,1,7,23,15,21,14,11,11,2,8,9};
    char c[100], target[] = "cash not needed";
    int i, j = 0, n = 0, k, value;

    for (i = 0; p[i]; i++)
        if (isalpha(p[i])) {
            value = (tolower(p[i]) - 'a' + key[j]) % 26;
            c[n++] = value + 'A';
            j++;
        }
    c[n] = '\0';

    printf("Encrypted text: %s\n", c);

    printf("Key for target plaintext: ");
    j = 0;
    for (i = 0; target[i]; i++)
        if (isalpha(target[i])) {
            k = (c[j] - 'A' - (tolower(target[i]) - 'a') + 26) % 26;
            printf("%d ", k);
            j++;
        }

    printf("\n");
    return 0;
}
