#include <stdio.h>

int main() {
    int P[2][2] = {{1, 2}, {3, 5}};
    int C[2][2] = {{21, 2}, {12, 19}};
    int det, inv, K[2][2];
    int i, j;

    det = (P[0][0]*P[1][1] - P[0][1]*P[1][0] + 26) % 26;

    for (i = 1; i < 26; i++)
        if ((det * i) % 26 == 1) {
            inv = i;
            break;
        }

    int Pinv[2][2] = {
        {P[1][1], (26-P[0][1])%26},
        {(26-P[1][0])%26, P[0][0]}
    };

    for (i = 0; i < 2; i++)
        for (j = 0; j < 2; j++)
            Pinv[i][j] = (Pinv[i][j] * inv) % 26;

    for (i = 0; i < 2; i++)
        for (j = 0; j < 2; j++) {
            K[i][j] = 0;
            for (int k = 0; k < 2; k++)
                K[i][j] = (K[i][j] + C[i][k]*Pinv[k][j]) % 26;
        }

    printf("Recovered Hill Cipher Key:\n");
    for (i = 0; i < 2; i++) {
        for (j = 0; j < 2; j++)
            printf("%d ", K[i][j]);
        printf("\n");
    }

    return 0;
}
