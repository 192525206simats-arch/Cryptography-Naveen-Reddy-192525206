
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char cipher[1000];
    char plain[1000];
    int shift, i, j, top = 10;

    printf("Enter ciphertext: ");
    fgets(cipher, sizeof(cipher), stdin);

    printf("Top how many plaintexts? ");
    scanf("%d", &top);

    for (shift = 0; shift < 26 && shift < top; shift++) {
        j = 0;

        for (i = 0; cipher[i]; i++) {
            if (isalpha(cipher[i])) {
                char ch = toupper(cipher[i]);
                plain[j++] = (ch - 'A' - shift + 26) % 26 + 'A';
            } else {
                plain[j++] = cipher[i];
            }
        }

        plain[j] = '\0';
        printf("Shift %2d: %s\n", shift, plain);
    }

    return 0;
}
