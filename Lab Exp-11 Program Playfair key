#include <stdio.h>
#include <math.h>

int main() {
    double keys, unique;
    int i;

    keys = 1;
    for (i = 1; i <= 25; i++)
        keys *= i;

    printf("Possible Playfair keys = 25! = approximately 2^83\n");

    unique = keys / (25 * 24);
    printf("Effectively unique keys = 25! / (25 * 24)\n");
    printf("Approximately 2^74\n");

    return 0;
}
